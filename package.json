{
  "name": "dayline-fitness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit false --outDir .test-build && node --test tests/*.test.mjs",
    "build": "vite build && node scripts/service-worker.mjs",
    "preview": "vite preview",
    "test:e2e": "tsc --noEmit false --outDir .test-build && playwright test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
